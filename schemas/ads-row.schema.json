{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta Ads Intelligence Row",
  "type": "object",
  "description": "Normalized row for Meta Ads performance analysis. Fields may be supplied by an API adapter or Ads Manager export.",
  "properties": {
    "date_start": {"type": "string"},
    "date_stop": {"type": "string"},
    "account_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "campaign_name": {"type": "string"},
    "adset_id": {"type": "string"},
    "adset_name": {"type": "string"},
    "ad_id": {"type": "string"},
    "ad_name": {"type": "string"},
    "objective": {"type": "string"},
    "spend": {"type": "number", "minimum": 0},
    "impressions": {"type": "number", "minimum": 0},
    "reach": {"type": "number", "minimum": 0},
    "clicks": {"type": "number", "minimum": 0},
    "outbound_clicks": {"type": "number", "minimum": 0},
    "conversions": {"type": "number", "minimum": 0},
    "purchases": {"type": "number", "minimum": 0},
    "revenue": {"type": "number", "minimum": 0},
    "purchase_value": {"type": "number", "minimum": 0},
    "currency": {"type": "string"},
    "ctr": {"type": "number", "minimum": 0},
    "cpc": {"type": "number", "minimum": 0},
    "cpm": {"type": "number", "minimum": 0},
    "cpa": {"type": "number", "minimum": 0},
    "roas": {"type": "number", "minimum": 0},
    "frequency": {"type": "number", "minimum": 0}
  },
  "additionalProperties": true
}
